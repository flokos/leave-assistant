{
  "id": "laErrorHandler01",
  "name": "Error handler — report to the backend",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "77ab564a-17da-5f29-94fd-694cc14255f5",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/internal/automation/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow.name, node: $json.execution.lastNodeExecuted, message: ($json.execution.error || {}).message, execution_id: String($json.execution.id || ''), mode: $json.execution.mode }) }}"
      },
      "id": "bb257017-9276-5d6b-857e-294ccf58f1e2",
      "name": "Report failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "laKeycloakAuto01",
          "name": "Leave API (automation)"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Report failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
