{
  "id": "laW1Documents001",
  "name": "W1 — Document processing watchdog",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "a4eaf81d-d728-5c6a-84da-f0bc72230551",
      "name": "Document uploaded",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "minutes"
      },
      "id": "7ace1979-720f-5e2f-abe1-c08c000c6f00",
      "name": "Wait 30 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "webhookId": "la-w1-watchdog-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://api:8000/api/v1/internal/documents/' + $('Document uploaded').item.json.payload.version_id + '/processing' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "tenant_id",
              "value": "={{ $('Document uploaded').item.json.tenant_id }}"
            }
          ]
        }
      },
      "id": "2b47bba1-0d6b-5c8a-bc0d-b911380fbba3",
      "name": "Processing status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "laKeycloakAuto01",
          "name": "Leave API (automation)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "84dfd446-502d-51f7-b7d1-f82a1f189e1b",
              "leftValue": "={{ $json.stalled }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ce519a48-b9ca-5aa7-a06f-4571ddadf594",
      "name": "Stalled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/internal/notifications",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $json.tenant_id, type: 'document.processing_stalled', subject_id: $json.version_id }) }}"
      },
      "id": "efd5f360-6e49-52a9-9a67-de90e38b406c",
      "name": "Notify uploader and admins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "laKeycloakAuto01",
          "name": "Leave API (automation)"
        }
      }
    }
  ],
  "connections": {
    "Document uploaded": {
      "main": [
        [
          {
            "node": "Wait 30 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 min": {
      "main": [
        [
          {
            "node": "Processing status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Processing status": {
      "main": [
        [
          {
            "node": "Stalled?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stalled?": {
      "main": [
        [
          {
            "node": "Notify uploader and admins",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "laErrorHandler01"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
