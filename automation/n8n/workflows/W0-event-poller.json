{
  "id": "laW0EventPoller1",
  "name": "W0 — Event poller",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 20
            }
          ]
        }
      },
      "id": "d05ee371-ff34-5710-9a68-b1fa044f56bd",
      "name": "Every 20 s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/api/v1/internal/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "50"
            }
          ]
        }
      },
      "id": "46959df3-2a1f-5867-869f-66281ea74a18",
      "name": "Lease events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "laKeycloakAuto01",
          "name": "Leave API (automation)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "dd616cdc-c021-516e-a01d-886524397bb7",
      "name": "Split events",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "ee218288-cf77-58e3-9714-44aaa0399f0b",
                    "leftValue": "={{ $json.type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "notification.created"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "email"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "informational"
        }
      },
      "id": "d630999d-92b5-54a4-8d22-0b2c32fe2ab6",
      "name": "Route by type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "laW4Notify000001",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "797f4a35-09f3-5f52-93c6-ea4d8bf6e5e5",
      "name": "W4 send e-mail",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        900,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/internal/events/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: [$(\"Split events\").item.json.id] }) }}"
      },
      "id": "300baff1-98b9-5680-bb7a-79eea0503a21",
      "name": "Ack e-mail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        -80
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "laKeycloakAuto01",
          "name": "Leave API (automation)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/internal/events/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: [$(\"Split events\").item.json.id] }) }}"
      },
      "id": "28c6cabb-a367-5e96-8110-2015808eb352",
      "name": "Ack informational",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        80
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "laKeycloakAuto01",
          "name": "Leave API (automation)"
        }
      }
    }
  ],
