{
  "realm": "leave-assistant",
  "displayName": "Leave Assistant",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "el"],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Self-service leave requests and company documents" },
      { "name": "manager", "description": "Approves requests of their department" },
      { "name": "hr_admin", "description": "HR administration: HR step, sick-leave confidentiality, retention" },
      { "name": "company_admin", "description": "Company configuration: employees, departments, policies" },
      { "name": "platform_admin", "description": "Platform administration: tenants and defaults; no tenant data" },
      { "name": "automation", "description": "Service accounts (n8n) limited to /internal/*" }
    ]
  },
  "groups": [
    { "name": "platform", "path": "/platform", "attributes": {}, "subGroups": [] },
    { "name": "tenants", "path": "/tenants", "attributes": {}, "subGroups": [] }
  ],
  "clients": [
    {
      "clientId": "backend-api",
      "name": "Leave Assistant API (audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "frontend-spa",
      "name": "Leave Assistant SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:8080",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:8080/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8080", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "backend-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant id (from group attribute)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "locale",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "locale",
            "claim.name": "locale",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "backend-admin",
      "name": "Backend provisioning service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "n8n-automation",
      "name": "n8n automation service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${N8N_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "backend-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "platform.admin",
      "enabled": true,
      "emailVerified": true,
      "email": "platform.admin@leave-assistant.example",
      "firstName": "Platform",
      "lastName": "Administrator",
      "credentials": [{ "type": "password", "value": "${SEED_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["platform_admin"],
      "groups": ["/platform"]
    },
    {
      "username": "service-account-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "backend-admin",
      "clientRoles": { "realm-management": ["manage-users", "view-users", "query-users", "query-groups", "view-realm"] }
    },
    {
      "username": "service-account-n8n-automation",
      "enabled": true,
      "serviceAccountClientId": "n8n-automation",
      "realmRoles": ["automation"]
    }
  ]
}
