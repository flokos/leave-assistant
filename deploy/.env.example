# Copy to deploy/.env and adjust. Values marked (dev) are development defaults for a local, non-exposed stack.
# The milestone in brackets says when a variable is first used.

# --- PostgreSQL [M0] -------------------------------------------------------
POSTGRES_PASSWORD=postgres-dev              # (dev) superuser; used only by init scripts and local tooling
LEAVE_DB_PASSWORD=app-rls-dev               # (dev) role app_rls — runtime role, NOBYPASSRLS (ADR-0003)
LEAVE_DB_OWNER_PASSWORD=app-owner-dev       # (dev) role app_owner — migrations [M1]
LANGGRAPH_DB_PASSWORD=langgraph-dev         # (dev) role langgraph_rw — checkpointer schema [M6]
KEYCLOAK_DB_PASSWORD=keycloak-dev           # (dev) Keycloak's own database
N8N_DB_PASSWORD=n8n-dev                     # (dev) [M8]
LANGFUSE_DB_PASSWORD=langfuse-dev           # (dev) [M9]

# --- Keycloak [M0/M1] --------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev       # (dev) console at http://localhost:8081
KC_PUBLIC_URL=http://localhost:8081         # issuer of tokens; what the browser uses
KEYCLOAK_ADMIN_CLIENT_SECRET=backend-admin-dev   # (dev) backend-admin service account (provisioning) [M1]
N8N_CLIENT_SECRET=n8n-automation-dev        # (dev) n8n-automation service account [M8]
SEED_USER_PASSWORD=leave-dev                # (dev) password of platform.admin and every seeded user [M1]

# --- SeaweedFS S3 [M0] -------------------------------------------------------
S3_ACCESS_KEY=leave
S3_SECRET_KEY=leave-secret-dev              # (dev)
S3_BUCKET_DOCUMENTS=leave-documents

# --- Application [M0] --------------------------------------------------------
APP_ENV=dev                                 # dev | test | prod
LOG_LEVEL=INFO
WORKER_MODE=separate                        # embedded on low-memory hosts (then: make up-staged)
API_PORT=8000                               # published only by compose.dev.yaml
FRONTEND_PORT=8080
KEYCLOAK_PORT=8081
MAILPIT_PORT=8025
POSTGRES_PORT=5432                          # published on 127.0.0.1 only (host-side tests, psql) [M1]

# --- Documents and ingestion [M4] (doc 05) ---------------------------------
MAX_UPLOAD_MB=25                            # per file; pages are capped by MAX_DOCUMENT_PAGES (500) in the backend
DOCUMENT_PROCESS_TIMEOUT_SECONDS=900        # wall clock per document job (Docling + OCR run in a child process)
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # revision pinned in config.py (ADR-0013)
OCR_LANGUAGES=ell,eng                       # Tesseract language packs installed in the image
TORCH_THREADS=2                             # api: query embeddings only
WORKER_TORCH_THREADS=4                      # worker child: parsing + passage embeddings
API_MEMORY_LIMIT=2G                         # make up-staged uses 3G (embedded worker)

# --- Feature flags [M4+] (doc 03 §7) -----------------------------------------
RETRIEVAL_BACKEND=pgvector                  # pgvector | chroma (eval profile)
CALENDAR_PROVIDER=mock                      # mock | google
LANGFUSE_ENABLED=false
LLM_PROVIDER_ORDER=gemini,groq              # decided Q-04: Gemini primary; Groq-first is a configuration change

# --- LLM providers [M6] — free tiers, fictional data only (ADR-0029) ---------
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Content security and privacy [M5] (doc 08 §7–§10) ----------------------
# Keys: base64, 32 bytes. `make env` fills empty values with `openssl rand -base64 32` (local use only; never
# commit deploy/.env). Without them the API refuses supporting-document uploads and documents cannot be indexed
# (fail closed). Rotating a key invalidates what it protects: APP_KEK → stored supporting documents,
# VAULT_KEK → vault originals, VAULT_HMAC_KEY → placeholder stability.
APP_KEK=
VAULT_HMAC_KEY=
VAULT_KEK=
PII_SCORE_THRESHOLD=0.4                     # Presidio confidence below which a finding is ignored
SUPPORTING_MAX_UPLOAD_MB=10                 # PDF / JPEG / PNG attached to leave requests
DOWNLOAD_TOKEN_TTL_SECONDS=60               # single-use supporting-document download links
RETENTION_SCAN_INTERVAL_SECONDS=86400       # worker loop: retention scan per tenant (make retention-scan runs it now)
INJECTION_LLM_JUDGE=false                   # platform default; the judge adapter arrives with the provider router [M6]

# --- Google Calendar [M8] ----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
