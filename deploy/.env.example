# Copy to deploy/.env and adjust. Values marked (dev) are development defaults for a local, non-exposed stack.
# The milestone in brackets says when a variable is first used.

# --- PostgreSQL [M0] -------------------------------------------------------
POSTGRES_PASSWORD=postgres-dev              # (dev) superuser; used only by init scripts and local tooling
LEAVE_DB_PASSWORD=app-rls-dev               # (dev) role app_rls — runtime role, NOBYPASSRLS (ADR-0003)
LEAVE_DB_OWNER_PASSWORD=app-owner-dev       # (dev) role app_owner — migrations [M1]
LANGGRAPH_DB_PASSWORD=langgraph-dev         # (dev) role langgraph_rw — checkpointer schema [M6]
KEYCLOAK_DB_PASSWORD=keycloak-dev           # (dev) Keycloak's own database
N8N_DB_PASSWORD=n8n-dev                     # (dev) [M8]
LANGFUSE_DB_PASSWORD=langfuse-dev           # (dev) [M9]

# --- Keycloak [M0/M1] --------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev       # (dev) console at http://localhost:8081
KC_PUBLIC_URL=http://localhost:8081

# --- SeaweedFS S3 [M0] -------------------------------------------------------
S3_ACCESS_KEY=leave
S3_SECRET_KEY=leave-secret-dev              # (dev)
S3_BUCKET_DOCUMENTS=leave-documents

# --- Application [M0] --------------------------------------------------------
APP_ENV=dev                                 # dev | test | prod
LOG_LEVEL=INFO
WORKER_MODE=separate                        # embedded on low-memory hosts (then: make up-staged / --scale worker=0)
API_PORT=8000                               # published only by compose.dev.yaml
FRONTEND_PORT=8080
KEYCLOAK_PORT=8081
MAILPIT_PORT=8025

# --- Feature flags [M4+] (doc 03 §7) -----------------------------------------
RETRIEVAL_BACKEND=pgvector                  # pgvector | chroma (eval profile)
CALENDAR_PROVIDER=mock                      # mock | google
LANGFUSE_ENABLED=false
LLM_PROVIDER_ORDER=gemini,groq              # decided Q-04: Gemini primary; Groq-first is a configuration change

# --- LLM providers [M6] — free tiers, fictional data only (ADR-0029) ---------
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Encryption keys [M5/M8] — generate with: openssl rand -base64 32 ---------
APP_KEK=
VAULT_HMAC_KEY=
VAULT_KEK=

# --- Google Calendar [M8] ----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
